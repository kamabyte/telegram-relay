# Required. Comma-separated IPs/CIDRs allowed to use the relay.
# Empty = deny everyone; 0.0.0.0/0,::/0 = allow everyone.
RELAY_ALLOWED_IPS=203.0.113.10,198.51.100.0/24

# Regex alternation of Bot API methods to relay (default: all methods).
# Example to restrict: sendMessage|editMessageText|deleteMessage
RELAY_ALLOWED_METHODS=[A-Za-z]+

# Relay file downloads (/file/bot<token>/<file_path>).
RELAY_ALLOW_FILES=true

# Max request body (uploads via sendDocument/sendPhoto etc.; Bot API limit is 50 MB).
RELAY_MAX_BODY_SIZE=50m

# Upstream read timeout; raise it if clients use long polling (getUpdates?timeout=N).
RELAY_READ_TIMEOUT=60s
